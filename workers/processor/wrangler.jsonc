{
  "name": "podads-processor",
  "main": "src/queue.ts",
  "compatibility_date": "2026-04-06",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "rules": [
    { "type": "Data", "globs": ["**/*.mp3"], "fallthrough": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "podads",
      "database_id": "725b5729-8e37-45b3-a847-b503a95854f9"
    }
  ],
  "r2_buckets": [
    {
      "binding": "AUDIO_BUCKET",
      "bucket_name": "podads-audio"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "PROCESSING_QUEUE",
        "queue": "podads-processing"
      }
    ],
    "consumers": [
      {
        "queue": "podads-processing",
        "max_batch_size": 1,
        "max_retries": 1,
        "retry_delay": 30
      }
    ]
  },
  "containers": [
    {
      "class_name": "TranscriberContainer",
      "name": "podads-transcriber-basic",
      "image": "../../services/transcriber/Dockerfile",
      "image_build_context": "../../",
      "max_instances": 1,
      "instance_type": "basic"
    },
    {
      "class_name": "LargeTranscriberContainer",
      "name": "podads-transcriber-large",
      "image": "../../services/transcriber/Dockerfile",
      "image_build_context": "../../",
      "max_instances": 1,
      "instance_type": {
        "vcpu": 1,
        "memory_mib": 3072,
        "disk_mb": 6000
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "TRANSCRIBER",
        "class_name": "TranscriberContainer"
      },
      {
        "name": "TRANSCRIBER_LARGE",
        "class_name": "LargeTranscriberContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TranscriberContainer"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["LargeTranscriberContainer"]
    }
  ],
  "vars": {
    "PROCESSING_VERSION": "v1",
    "CLASSIFICATION_PROVIDER": "openrouter",
    "POSTHOG_HOST": "https://us.i.posthog.com"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  }
}
